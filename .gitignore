# ─────────────────────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ─────────────────────────────────────────────────────────────
# 가상환경
#   루트 .venv 는 공통 프레임워크용,
#   labs/*/.venv 는 라이브러리별 의존성 격리용(torch 핀 충돌 회피)
# ─────────────────────────────────────────────────────────────
.venv/
venv/
env/
labs/*/.venv/
uv.lock

# ─────────────────────────────────────────────────────────────
# 비밀정보 — 절대 커밋 금지
#   인증은 az CLI(Entra ID) 사용을 권장하고, 키는 .env 로만 다룬다.
#   .env.example 은 값 없이 키 이름만 담아 커밋한다.
# ─────────────────────────────────────────────────────────────
.env
.env.*
*.env
!.env.example
.envrc

# 키·인증서
*.key
*.pem
*.pfx
*.p12
*.jks
*.keystore
id_rsa*
*_rsa
*.ppk

# 자격증명 파일
secrets.*
**/credentials.json
.netrc
.npmrc
.pypirc
.htpasswd

# 클라우드·IaC 상태 (구독 ID·리소스명·연결문자열이 들어갑니다)
.azure/
.azd/
local.settings.json
*.publishsettings
*.tfvars
!*.tfvars.example
*.tfstate
*.tfstate.*
.terraform/

# ─────────────────────────────────────────────────────────────
# 실험 산출물 (runs/)
#   metrics.json / report.md / config.snapshot.yaml 는 재현·비교에 필요하므로 남긴다.
#   records.jsonl 은 원문+압축문을 통째로 담아 크고 고객 데이터가 섞일 수 있어 제외한다.
# ─────────────────────────────────────────────────────────────
runs/**
!runs/.gitkeep
!runs/**/
!runs/**/metrics.json
!runs/**/report.md
!runs/**/config.snapshot.yaml
!runs/**/pier.yaml
!runs/**/arms.json
runs/**/records.jsonl
runs/**/*.raw.json

# ─────────────────────────────────────────────────────────────
# 공유 코퍼스 (labs/data/)
#   용량도 문제지만 고객 데이터가 섞일 수 있어 통째로 제외한다.
#   재현은 fetch.sh + manifest.json 으로 한다.
# ─────────────────────────────────────────────────────────────
labs/data/**
!labs/data/README.md
!labs/data/fetch.sh
!labs/data/**/
!labs/data/**/manifest.json
!labs/data/**/.gitkeep

# sample/ 은 예외 — 합성 데이터이고 하네스 스모크 테스트에 필요합니다
!labs/data/sample/**
!labs/data/sample-structured/**
!labs/data/sample-long/**
!labs/data/sample-bilingual/**
!labs/data/make_synthetic.py
!labs/data/make_bilingual.py

# ─────────────────────────────────────────────────────────────
# DeepSWE 데이터셋 (labs/agentic-eval/)
#   setup.sh 로 클론한다. 코퍼스가 아니라 Docker 실행 픽스처라
#   labs/data/ 가 아니라 유일한 소비자 안에 둔다.
# ─────────────────────────────────────────────────────────────
labs/agentic-eval/datasets/deep-swe/
# 한국어 데이터셋은 deep-swe/ 를 가리키는 심볼릭 링크 모음이라 그쪽이
# 없으면 뜻이 없습니다. i18n.py stage 로 언제든 다시 만듭니다.
# 번역 원본인 i18n/ko/ 는 커밋합니다 — 번역 비용을 다시 치르지 않으려는 것입니다.
labs/agentic-eval/datasets/deep-swe-ko/

# 참조 핸들(labs/04)이 원문을 떨궈두는 곳
**/store/
**/_store/

# ─────────────────────────────────────────────────────────────
# 모델·토크나이저 캐시 (수 GB 단위)
# ─────────────────────────────────────────────────────────────
.cache/
models/
# 모델 가중치. 확장자로 거르는 것은 **보조 수단**입니다 —
# HuggingFace 캐시의 실제 파일은 확장자가 없는 SHA 이름이라 아래
# 디렉터리 규칙이 진짜 방어선입니다.
*.safetensors
*.bin
*.gguf
*.pt
*.pth
*.ckpt
*.h5
*.msgpack
*.npz
*.model

# HuggingFace / 모델 캐시가 저장소 안에 생기는 경우.
# HF_HOME 이나 TRANSFORMERS_CACHE 를 상대경로로 지정하면 이렇게 됩니다.
# 캐시 안의 가중치 파일은 88c142... 같은 확장자 없는 이름이라
# 위의 확장자 규칙으로는 절대 못 잡습니다. 1GB 가 그냥 커밋됩니다.
**/models--*/
**/hub/models--*/
.hfcache/
hf_cache/
**/.cache/huggingface/
*.onnx
.hf_home/
huggingface/
data_gym_cache/          # tiktoken BPE 캐시

# ─────────────────────────────────────────────────────────────
# 노트북
#   ★ .gitignore 로는 '출력' 을 막을 수 없다. 파일 단위로만 걸러지기 때문이다.
#     출력에는 엔드포인트·응답 본문·리소스명이 박힐 수 있으므로
#     커밋 전에 반드시 출력을 지운다:
#
#         python scripts/strip_outputs.py            # 전체 검사 + 제거
#         python scripts/strip_outputs.py --check    # 제거 없이 검사만 (CI용)
#
#     자동화하려면 git filter 를 걸면 된다:
#         git config filter.nbstrip.clean "python scripts/strip_outputs.py --stdin"
#         echo '*.ipynb filter=nbstrip' >> .gitattributes
# ─────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*-checkpoint.ipynb
*.nbconvert.ipynb

# ─────────────────────────────────────────────────────────────
# 도구·에디터
# ─────────────────────────────────────────────────────────────
.vscode/
!.vscode/settings.json
.idea/
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/

# ─────────────────────────────────────────────────────────────
# OS
# ─────────────────────────────────────────────────────────────
.DS_Store
._*
Thumbs.db

# ─────────────────────────────────────────────────────────────
# 임시
# ─────────────────────────────────────────────────────────────
tmp/
scratch/
*.tmp
*.log

# --- labs ---
labs/.env
labs/kit/.cache/
labs/*/.cache/
labs/runs/

# 실행 결과는 전부 제외합니다. 위쪽 71~79행에 metrics.json 만 남기는
# 규칙이 있었지만, 개발 중 실행이 쌓이면서 타임스탬프 폴더가 수십 개씩
# 생겨 실제로는 잡음이 됐습니다.
#
# 남길 가치가 있는 결과는 compare/results/ 에 정리해서 커밋합니다.
# 그쪽은 "무엇을 알아냈나" 단위라 실행 횟수와 무관하게 개수가 유지됩니다.
runs/

# 공유받은 외부 문서를 두는 곳입니다. 저작권·기밀 문제가 있을 수 있어
# 저장소에 올리지 않습니다. 폴더째 제외합니다.
NOT_UPLOADED/
