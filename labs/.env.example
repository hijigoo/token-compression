# 랩 실행 설정입니다. 복사해서 쓰세요:
#     cp .env.example .env
# .env 는 커밋되지 않습니다(.gitignore).
#
# scripts/explore/.env.example 과 변수명이 같습니다.
# 이미 그쪽에 .env 를 만들어 두었다면 그대로 복사해도 됩니다:
#     cp ../scripts/explore/.env .env

# --- Foundry / Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://<리소스명>.cognitiveservices.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-5.4
AZURE_OPENAI_API_VERSION=2024-10-21

# 비워두면 az CLI 의 Entra ID 토큰을 사용합니다(az login).
# 키를 파일에 남기지 않는 편이 안전하므로 되도록 비워두세요.
AZURE_OPENAI_API_KEY=

# az CLI 가 PATH 에 없을 때 전체 경로를 지정합니다 (VS Code 커널에서 흔함).
# AZ_CLI=/opt/homebrew/bin/az
