# 복사해서 쓰세요:  cp .env.example .env
# .env 는 커밋되지 않습니다(.gitignore).
#
# 권장: 아래 키를 비워두고 az CLI 로 인증하세요.
#         az login
#       Entra ID 토큰을 쓰면 키를 파일에 남기지 않습니다.

# --- Foundry / Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://<리소스명>.cognitiveservices.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-5.4
AZURE_OPENAI_API_VERSION=2024-10-21

# 비워두면 az CLI 의 Entra ID 토큰을 사용합니다. 되도록 비워두세요.
AZURE_OPENAI_API_KEY=

# --- 선택 ---
# HF_HOME=./.hf_home                 # 모델 캐시를 프로젝트 안에 두고 싶을 때
# HEADROOM_OUTPUT_HOLDOUT=0.1        # labs/07: 절감률을 estimated -> measured 로
